# =============================================================================
# Database — Neon (PostgreSQL)
# =============================================================================
# Neon project: https://console.neon.tech/
# Create a project, then copy the connection string for each branch below.
#
# IMPORTANT: append ?sslmode=require&connection_limit=1 to all Neon URLs.
# connection_limit=1 is required for serverless/edge function environments.
#
# Branch URLs (set DATABASE_URL to the branch matching your environment):
#
#   dev branch:
#     postgresql://user:password@ep-xxx-dev.us-east-2.aws.neon.tech/dbname?sslmode=require&connection_limit=1
#
#   staging branch:
#     postgresql://user:password@ep-xxx-staging.us-east-2.aws.neon.tech/dbname?sslmode=require&connection_limit=1
#
#   prod branch (to be added when production is provisioned):
#     postgresql://user:password@ep-xxx-prod.us-east-2.aws.neon.tech/dbname?sslmode=require&connection_limit=1
#
# Prisma connection pooling (pgBouncer): if using Neon's connection pooler add
#   &pgbouncer=true&connect_timeout=15 to the end of the URL.
DATABASE_URL="postgresql://user:password@ep-xxx-dev.us-east-2.aws.neon.tech/cyba?sslmode=require&connection_limit=1"

# =============================================================================
# Next.js
# =============================================================================
NODE_ENV="development"

# =============================================================================
# NextAuth.js (required when auth is added)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# =============================================================================
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
